# ==============================================================================
# AIgnite - Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase BaaS (Backend-as-a-Service)
# Free Tier: 500 MB PostgreSQL, 50k MAU Auth, 1 GB Storage, 500k Edge Invocations
# Create a free project at: https://supabase.com/
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-supabase-publishable-key
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key

# ------------------------------------------------------------------------------
# 2. PostgreSQL Connection for Drizzle ORM (Supabase Transaction Pooler)
# Use the "Transaction" pooler connection string on port 6543 for serverless Next.js
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 3. Google Gemini Flash API (Google AI Studio Free Tier)
# Free Limits: 15 RPM, 1,000,000 TPM, 1,500 RPD
# Used for: Voice Coach grading, 5-Metric AI Report Cards, Decision Simulators, News Quizzes
# Default Model: gemini-3.6-flash (can be customized via GEMINI_MODEL - 5 RPM / 20 RPD)
# Get free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------------------------
# 4. Groq Cloud Speech API (Free Tier Whisper STT)
# Free Limits: Whisper-large-v3 ultra-low latency transcription
# Used for: Transcribing student spoken interview answers in under 1.5 seconds
# Get free key at: https://console.groq.com/
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_yourGroqCloudApiKeyHere

# ------------------------------------------------------------------------------
# 5. Transactional Email / OTP Delivery (Free Tier)
# Free Limits: 3,000 emails/month (100 emails/day)
# Used for: Passwordless 6-digit Email OTP sign-in and Recruiter approval notifications
# Get free key at: https://resend.com/
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_yourResendApiKeyHere

# ------------------------------------------------------------------------------
# 6. Public AI News Feeds (Open Access / No API Key Needed)
# Curated daily breakthroughs and research papers for the AIgnite Pulse feed
# ------------------------------------------------------------------------------
HUGGINGFACE_DAILY_PAPERS_API=https://huggingface.co/api/daily_papers
ARXIV_API_ENDPOINT=https://export.arxiv.org/api/query

# ------------------------------------------------------------------------------
# 7. Mobile App & Habit Notifications (React Native / Expo)
# 100% Free Open Source & Free Expo Application Services (EAS) tier
# ------------------------------------------------------------------------------
EXPO_PROJECT_ID=your-expo-project-id
# Optional: FCM Server Key for native Android push notifications
FIREBASE_SERVER_KEY=your-firebase-server-key

# ------------------------------------------------------------------------------
# 8. Web Application URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
